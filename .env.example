# Trix Server Configuration
# IP address of your MatrixPortal M4 running trix-server
TRIX_SERVER_IP=192.168.1.115

# Trix Server API Key
# This should match the TRIX_API_KEY set in your trix-server settings.toml
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
TRIX_API_KEY=your-secret-api-key-here

# AWS Credentials (optional - only needed for S3 image provider)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
